/// Order management types
package demo.orders;

use demo.common.Address;
use demo.users.User;

/// Represents a customer order
#[rename_all = "camelCase"]
struct Order {
    /// Unique order identifier
    id: String,
    /// Reference to the user who placed the order
    user_id: String,
    /// The user who placed the order (denormalized)
    user: Option<User>,
    /// Items in this order
    items: Vec<OrderItem>,
    /// Total order amount as string (for precision)
    total: String,
    /// Order status
    status: OrderStatus,
    /// Shipping address (imported from common)
    shipping_address: Address,
    /// Billing address (if different from shipping)
    billing_address: Option<Address>,
    /// When the order was placed
    created_at: String,
    /// Optional tracking number
    tracking_number: Option<String>,
}

/// An item within an order
#[rename_all = "camelCase"]
struct OrderItem {
    /// Product identifier
    product_id: String,
    /// Product name
    name: String,
    /// Quantity ordered
    quantity: u32,
    /// Price per unit as string
    unit_price: String,
}

/// Possible order statuses
enum OrderStatus {
    Pending,
    Confirmed,
    Processing,
    Shipped,
    Delivered,
    Cancelled,
    Refunded,
}

/// Event types for order lifecycle
#[type_tag = "type"]
union OrderEvent {
    Created(Order),
    Updated(Order),
    StatusChanged(OrderStatusChange),
    Cancelled(OrderCancellation),
}

/// Order status change details
#[rename_all = "camelCase"]
struct OrderStatusChange {
    order_id: String,
    old_status: OrderStatus,
    new_status: OrderStatus,
    changed_at: String,
}

/// Order cancellation details
#[rename_all = "camelCase"]
struct OrderCancellation {
    order_id: String,
    reason: String,
    refund_amount: Option<String>,
    cancelled_at: String,
}

/// Map of order IDs to orders
type OrderMap = Map<String, Order>;

/// List of order events
type OrderEventStream = Vec<OrderEvent>;
