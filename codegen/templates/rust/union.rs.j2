{{ derives }}
#[serde(tag = "{{ tag_field }}", content = "{{ content_field }}")]
pub enum {{ name }} {
{%- for variant in variants %}
{%- match variant %}
{%- when UnionVariantTemplate::Unit with { name, doc } %}
{%- if doc != "" %}
    /// {{ doc|safe }}
{%- endif %}
    {{ name }},
{%- when UnionVariantTemplate::Newtype with { name, type_str, doc } %}
{%- if doc != "" %}
    /// {{ doc|safe }}
{%- endif %}
    {{ name }}({{ type_str|safe }}),
{%- endmatch %}
{%- endfor %}
}

