{%- if !imports.is_empty() %}
{%- for import in imports %}
import { {{ import.name }} } from '{{ import.path }}';
{%- endfor %}

{%- endif %}
{%- if !doc.is_empty() %}
/**
{%- for line in doc %}
 {{ line }}
{%- endfor %}
 */
{%- endif %}
export type {{ name }} =
{%- for variant in variants %}
{%- match variant %}
{%- when TsUnionVariantTemplate::Unit with { name, doc } %}
{%- if !doc.is_empty() %}
  /**
{%- for line in doc %}
   {{ line }}
{%- endfor %}
   */
{%- endif %}
  | { {{ tag_field }}: "{{ name }}" }
{%- when TsUnionVariantTemplate::Newtype with { name, type_str, doc } %}
{%- if !doc.is_empty() %}
  /**
{%- for line in doc %}
   {{ line }}
{%- endfor %}
   */
{%- endif %}
  | { {{ tag_field }}: "{{ name }}"; {{ content_field }}: {{ type_str|safe }} }
{%- endmatch %}
{%- endfor %};
