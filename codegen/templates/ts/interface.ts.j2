{%- if !imports.is_empty() %}
{%- for import in imports %}
import { {{ import.name }} } from '{{ import.path }}';
{%- endfor %}

{%- endif %}
{%- if !doc.is_empty() %}
/**
{%- for line in doc %}
 {{ line }}
{%- endfor %}
 */
{%- endif %}
export interface {{ name }} {
{%- for field in fields %}
{%- if !field.doc.is_empty() || field.deprecated %}
  /**
{%- for line in field.doc %}
   {{ line }}
{%- endfor %}
{%- if field.deprecated %}
   * @deprecated
{%- endif %}
   */
{%- endif %}
{%- if use_readonly %}
  readonly {{ field.code_name }}{% if field.is_optional %}?{% endif %}: {{ field.type_str|safe }};
{%- else %}
  {{ field.code_name }}{% if field.is_optional %}?{% endif %}: {{ field.type_str|safe }};
{%- endif %}
{%- endfor %}
}
