{
  "name": "@zhxiaogg/fluorite-cli",
  "version": "0.3.0",
  "description": "Code generator from YAML/Fluorite schema definitions - generates Rust and TypeScript",
  "bin": {
    "fluorite": "./bin/fluorite.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "keywords": [
    "codegen",
    "typescript",
    "rust",
    "schema",
    "yaml",
    "idl"
  ],
  "author": "shawn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blossomstack/fluorite.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "optionalDependencies": {
    "@zhxiaogg/fluorite-darwin-x64": "0.3.0",
    "@zhxiaogg/fluorite-darwin-arm64": "0.3.0",
    "@zhxiaogg/fluorite-linux-x64": "0.3.0",
    "@zhxiaogg/fluorite-linux-arm64": "0.3.0",
    "@zhxiaogg/fluorite-win32-x64": "0.3.0"
  }
}
